# apps/web/.env.local — copy to .env.local for the UI.

# Supabase (anon key — safe for the browser; RLS restricts writes to products + cards)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lets the "Check now" button trigger the GitHub Actions run (server-side only).
GITHUB_TOKEN=                       # fine-grained PAT, actions:write on the repo
GITHUB_REPO=your-user/dropwatch     # owner/repo

# Optional: verify Slack button callbacks (v1.1)
# SLACK_SIGNING_SECRET=
