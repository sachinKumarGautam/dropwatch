# ─── DropWatch environment (worker) ─────────────────────────────────────────
# Copy to .env for local runs. Everything runs in DRY_RUN with ZERO real keys.

# ── Run mode ────────────────────────────────────────────────────────────────
# DRY_RUN=1 → fixtures + mock LLM + captured Slack. No external calls, no keys.
# Set 0 (or unset) for live operation.
DRY_RUN=1

# Delivery pincode — Indian prices/availability are pincode-dependent.
DEFAULT_PINCODE=560102

# ── LLM (provider-agnostic; you supply an OpenAI key) ───────────────────────
LLM_PROVIDER=openai                 # openai | anthropic | mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini            # cheap model: extraction + offer parsing
LLM_REASONING_MODEL=gpt-4o          # smarter model: product matching + reasoning
# OPENAI_BASE_URL=                  # optional (proxy / compatible endpoint)
# For LLM_PROVIDER=anthropic instead:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Scraping ────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=                  # primary scraper for Amazon.in / Flipkart (1000 free/mo)
# SCRAPERAPI_KEY=                   # optional overflow

# ── Cross-platform discovery ────────────────────────────────────────────────
SERPAPI_KEY=                        # Google Shopping (~100 free searches/mo)

# ── Storage: Supabase Postgres (free tier) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # worker only — keep secret

# ── Alerts: Slack incoming webhook ──────────────────────────────────────────
SLACK_WEBHOOK_URL=
# SLACK_OPS_WEBHOOK_URL=            # optional separate channel for scraper-health
# SLACK_SIGNING_SECRET=            # for the v1.1 button interactivity endpoint

# ── Behaviour knobs (optional; defaults shown) ──────────────────────────────
# ALERT_THRESHOLD_IMMEDIATE=70
# ALERT_THRESHOLD_DIGEST=55
# CAP_PER_PRODUCT_PER_DAY=2
# CAP_GLOBAL_PER_DAY=8
